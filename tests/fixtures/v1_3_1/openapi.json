{
  "components": {
    "schemas": {
      "ErrorEnvelope": {
        "properties": {
          "error": {
            "properties": {
              "code": {
                "enum": [
                  "unauthorized",
                  "forbidden",
                  "not_found",
                  "validation_error",
                  "conflict",
                  "integrity_gate_failed",
                  "stale_schema",
                  "rate_limited",
                  "idempotency_conflict",
                  "payload_too_large",
                  "unsupported_operation",
                  "internal_error"
                ],
                "type": "string"
              },
              "details": {
                "type": "object"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message",
              "details"
            ],
            "type": "object"
          },
          "request_id": {
            "type": "string"
          }
        },
        "required": [
          "error",
          "request_id"
        ],
        "type": "object"
      },
      "ResponseEnvelope": {
        "properties": {
          "data": {},
          "pagination": {
            "type": [
              "object",
              "null"
            ]
          },
          "request_id": {
            "type": "string"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "data",
          "request_id",
          "warnings"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
